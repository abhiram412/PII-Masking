# ============================================================
# Quantum Data Masking & PQC — Environment
# ============================================================

# REQUIRED for real IBM Quantum hardware runs
# Get your free API token from: https://quantum.ibm.com  →  Account  →  API token
# Paste it below (no quotes). The engine will automatically use IBM backends.
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here

# Optional: pin a specific IBM backend (e.g. ibm_fez, ibm_torino, ibm_brisbane)
# Leave empty to let the service pick the least-busy operational QPU.
# IBM_QUANTUM_BACKEND=ibm_fez

# Path to the SQLite bank database (created by seed.py)
BANK_DB=data/bank.db

# Folder that contains the original organiser CSVs
DATASET_DIR=data/csv
